<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cc.bugcat.bcdt.ops.dao.zentao.BcDbSetDao">
	
    
    <select id="selectByName" resultType="cc.bugcat.bcdt.ops.model.zentao.BcDbSet">
        select * from bc_db_set a where a.username = #{username} limit 1
    </select>

    <select id="selectByBean" resultType="string" parameterType="cc.bugcat.bcdt.ops.model.zentao.BcDbSet">
        select a.password from bc_db_set a where a.username = #{username}
    </select>


</mapper>